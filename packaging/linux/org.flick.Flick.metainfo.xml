<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.flick.Flick</id>
  <name>Flick</name>
  <summary>A fast, focused image viewer</summary>
  <metadata_license>FSFAP</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.lannselot">
    <name>Flick contributors</name>
  </developer>
  <description>
    <p>
      Flick opens local images in a minimal, keyboard-accessible viewer with
      directory navigation, animation, zoom, fullscreen, and color management.
    </p>
  </description>
  <url type="homepage">https://github.com/Lannselot/Flick</url>
  <content_rating type="oars-1.1"/>
  <launchable type="desktop-id">org.flick.Flick.desktop</launchable>
  <provides>
    <binary>flick</binary>
    <mediatype>image/jpeg</mediatype>
    <mediatype>image/png</mediatype>
    <mediatype>image/webp</mediatype>
    <mediatype>image/gif</mediatype>
    <mediatype>image/bmp</mediatype>
  </provides>
</component>
